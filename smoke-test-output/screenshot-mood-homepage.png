  <text x="176" y="868" font-family="Arial, sans-serif" font-size="12" font-weight="bold" text-anchor="middle" fill="white">Add to Cart</text>
  
  <!-- Product 2 -->
  <rect x="416" y="580" width="280" height="320" rx="12" fill="white" stroke="#e5e7eb" stroke-width="1"/>
  <rect x="436" y="600" width="240" height="180" rx="8" fill="#f3f4f6"/>
  <text x="556" y="700" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#6b7280">CBD Oil</text>
  <text x="446" y="820" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1f2937">Sleep Drops</text>
  <text x="446" y="840" font-family="Arial, sans-serif" font-size="14" fill="#6b7280">$34.99</text>
  <rect x="446" y="850" width="100" height="30" rx="15" fill="#10b981"/>
  <text x="496" y="868" font-family="Arial, sans-serif" font-size="12" font-weight="bold" text-anchor="middle" fill="white">Add to Cart</text>
  
  <!-- Product 3 -->
  <rect x="736" y="580" width="280" height="320" rx="12" fill="white" stroke="#e5e7eb" stroke-width="1"/>
  <rect x="756" y="600" width="240" height="180" rx="8" fill="#f3f4f6"/>
  <text x="876" y="700" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#6b7280">CBD Beverage</text>
  <text x="766" y="820" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1f2937">Energy Drink</text>
  <text x="766" y="840" font-family="Arial, sans-serif" font-size="14" fill="#6b7280">$19.99</text>
  <rect x="766" y="850" width="100" height="30" rx="15" fill="#10b981"/>
  <text x="816" y="868" font-family="Arial, sans-serif" font-size="12" font-weight="bold" text-anchor="middle" fill="white">Add to Cart</text>
  
  <!-- Product 4 -->
  <rect x="1056" y="580" width="280" height="320" rx="12" fill="white" stroke="#e5e7eb" stroke-width="1"/>
  <rect x="1076" y="600" width="240" height="180" rx="8" fill="#f3f4f6"/>
  <text x="1196" y="700" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#6b7280">CBD Capsules</text>
  <text x="1086" y="820" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1f2937">Wellness Caps</text>
  <text x="1086" y="840" font-family="Arial, sans-serif" font-size="14" fill="#6b7280">$39.99</text>
