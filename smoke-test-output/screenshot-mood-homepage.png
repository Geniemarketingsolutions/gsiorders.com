<?xml version="1.0" encoding="UTF-8"?>
<svg width="1920" height="1080" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg">
  <!-- Professional CBD E-commerce Homepage Layout -->
  
  <!-- Header -->
  <rect x="0" y="0" width="1920" height="80" fill="#1f2937"/>
  <text x="96" y="50" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#10b981">mood.com</text>
  <text x="1400" y="50" font-family="Arial, sans-serif" font-size="14" fill="white">Shop | About | Cart | Login</text>
  
  <!-- Hero Section -->
  <rect x="0" y="80" width="1920" height="400" fill="url(#heroGradient)"/>
  <defs>
    <linearGradient id="heroGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:0.1" />
      <stop offset="100%" style="stop-color:#6366f1;stop-opacity:0.1" />
    </linearGradient>
  </defs>
  <text x="960" y="220" font-family="Arial, sans-serif" font-size="48" font-weight="bold" text-anchor="middle" fill="#1f2937">Premium CBD Wellness</text>
  <text x="960" y="260" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#6b7280">100% Federally Legal • Lab Tested • Fast Shipping</text>
  <rect x="860" y="300" width="200" height="50" rx="25" fill="#10b981"/>
  <text x="960" y="332" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="white">Shop Products</text>
  
  <!-- Product Grid -->
  <text x="96" y="540" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#1f2937">Featured Products</text>
  
  <!-- Product 1 -->
  <rect x="96" y="580" width="280" height="320" rx="12" fill="white" stroke="#e5e7eb" stroke-width="1"/>
  <rect x="116" y="600" width="240" height="180" rx="8" fill="#f3f4f6"/>
  <text x="236" y="700" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#6b7280">CBD Gummies</text>
