  <!-- Footer -->
  <rect x="0" y="980" width="1920" height="100" fill="#374151"/>
  <text x="96" y="1020" font-family="Arial, sans-serif" font-size="14" fill="#9ca3af">© 2024 mood.com | Lab Tested | FDA Compliant | 100% Legal</text>
  <text x="96" y="1040" font-family="Arial, sans-serif" font-size="12" fill="#6b7280">Contact: support@mood.com | (800) 555-MOOD</text>
